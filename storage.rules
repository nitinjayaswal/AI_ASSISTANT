rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if request is from an authenticated admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@college\\.edu$') ||
        request.auth.token.role == 'admin'
      );
    }

    // Public students can view/download official policy PDFs
    // Only verified college administrators can upload or delete PDF documents
    match /documents/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() 
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
  }
}
