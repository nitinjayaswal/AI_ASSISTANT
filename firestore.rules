rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is from an authenticated admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*@college\\.edu$') ||
          request.auth.token.email.matches('.*@uiet\\.ac\\.in$')
        ))
      );
    }

    // Public read-only access for students to access official college documents
    // Only verified college administrators can upload or delete documents
    match /documents/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      // Sub-collection for document chunks
      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Global indexed chunks collection for fast semantic retrieval
    match /chunks/{chunkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Previous year question papers (PYQs) archive
    match /papers/{paperId} {
      allow read: if true;
      allow write: if true;
    }

    // Official campus circulars and announcements (with image links support)
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if true;
    }

    // Direct and hosted image link repository (including image collection shown in console)
    match /image/{imageId} {
      allow read: if true;
      allow write: if true;
    }

    match /images/{imageId} {
      allow read: if true;
      allow write: if true;
    }

    // Student user profiles authenticated with Google / Gmail
    match /students/{studentId} {
      allow read: if request.auth != null && (request.auth.uid == studentId || isAdmin());
      allow create, update: if request.auth != null && (request.auth.uid == studentId || isAdmin());
      allow delete: if isAdmin();
    }

    // Student query telemetry & citation feedback
    match /chatHistory/{sessionId} {
      allow read, write: if true;
    }
  }
}
