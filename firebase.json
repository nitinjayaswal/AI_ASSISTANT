{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "server.ts"
    ],
    "rewrites": [
      {
        "source": "/api/uploadPDF",
        "function": "uploadPDF"
      },
      {
        "source": "/api/searchDocuments",
        "function": "searchDocuments"
      },
      {
        "source": "/api/generateAnswer",
        "function": "generateAnswer"
      },
      {
        "source": "/api/**",
        "function": "generateAnswer"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": [
    {
      "database": "ai-studio-collegeaiassista-3b073e3e-0862-4f78-a6c0-e7bebff9c153",
      "rules": "firestore.rules"
    },
    {
      "database": "(default)",
      "rules": "firestore.rules"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
